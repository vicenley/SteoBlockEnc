@FOOTNOTE{Note1,key="Note1",note="Allowing a complex signal $z\in \protect \mathbb  {C}$ and arbitrary $\protect \mathrm  {SU}(2)$ rotations in place of the phase rotations gives the stereographic form of generalized QSP~\cite {MotlaghWiebe2023}, whose entries are polynomials in $z$ and $\protect \bar  z$ of total degree at most $d$. The Supplemental Material~\cite {supp} gives the proof and relates the construction to the nonlinear Fourier transform. The generalized form is not used here."}
@FOOTNOTE{Note2,key="Note2",note="For $L=1$ and $y_0=0$ the functions $\sin \theta \protect \,e^{i(2k+1)\theta }$ that span this basis are $(y+i)^k/(y-i)^{k+1}$, the orthogonal rational functions of Christov and Higgins~\cite {Boyd1990}."}
@FOOTNOTE{Note3,key="Note3",note="The state of Eq.~\protect \eqref  {eq:target-state}, which samples $G$ itself, lies within $2\sup _\theta |G-p|/\protect \mathcal  {F}_p$ of the prepared state in Euclidean norm, with $G$ scaled as $p$. For targets of the Boyd class this uniform error decays with $d$ at the rate of $\varepsilon $."}
@FOOTNOTE{Note4,key="Note4",note="A numerical minimization of the $L^2$ error over $L$ at each degree up to $d=85$, where the error is $10^{-12}$, reproduces the three exponents: we find $0.66$, $0.34$, and $1.75$ against $2/3$, $1/3$, and $7/4$."}
